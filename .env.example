# Use a conexão direta com o PostgreSQL, com suporte a LISTEN/NOTIFY.
DATABASE_URL=postgresql://estoque:senha-local@127.0.0.1:5432/estoque
PORT=3001
# Ative só quando o Node estiver acessível exclusivamente por um proxy confiável de um salto.
TRUST_PROXY=0
MASTER_NAME="Administrador da operação"
MASTER_EMAIL=master@example.com
MASTER_PASSWORD=
# Use apenas para povoar um banco separado de homologação.
SEED_PASSWORD=
